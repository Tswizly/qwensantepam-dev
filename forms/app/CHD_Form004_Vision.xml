      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/case_history_group/history_premature" type="string" required="true()"/>
      <bind nodeset="/data/case_history_group/history_premature_label" type="string" calculate="jr:choice-name( /data/case_history_group/history_premature , ' /data/case_history_group/history_premature ')"/>
      <bind nodeset="/data/case_history_group/history_low_birth_weight" type="string" required="true()"/>
      <bind nodeset="/data/case_history_group/history_low_birth_weight_label" type="string" calculate="jr:choice-name( /data/case_history_group/history_low_birth_weight , ' /data/case_history_group/history_low_birth_weight ')"/>
      <bind nodeset="/data/case_history_group/history_birth_defects" type="string" required="true()"/>
      <bind nodeset="/data/case_history_group/history_birth_defects_label" type="string" calculate="jr:choice-name( /data/case_history_group/history_birth_defects , ' /data/case_history_group/history_birth_defects ')"/>
      <bind nodeset="/data/case_history_group/history_parent_concerns" type="string" required="true()"/>
      <bind nodeset="/data/case_history_group/history_parent_concerns_label" type="string" calculate="jr:choice-name( /data/case_history_group/history_parent_concerns , ' /data/case_history_group/history_parent_concerns ')"/>
      <bind nodeset="/data/case_history_group/history_eye_pain" type="string" required="true()"/>
      <bind nodeset="/data/case_history_group/history_eye_pain_label" type="string" calculate="jr:choice-name( /data/case_history_group/history_eye_pain , ' /data/case_history_group/history_eye_pain ')"/>
      <bind nodeset="/data/case_history_group/history_diabetes" type="string" required="true()"/>
      <bind nodeset="/data/case_history_group/history_diabetes_label" type="string" calculate="jr:choice-name( /data/case_history_group/history_diabetes , ' /data/case_history_group/history_diabetes ')"/>
      <bind nodeset="/data/distance_va_group" relevant=" /data/patient_age_in_years  &gt;= 3 and  /data/patient_age_in_years  &lt;= 5"/>
      <bind nodeset="/data/distance_va_group/distance_va_note" readonly="true()" type="string"/>
      <bind nodeset="/data/distance_va_group/va_distance_right" type="string" required="true()"/>
      <bind nodeset="/data/distance_va_group/va_distance_right_label" type="string" calculate="jr:choice-name( /data/distance_va_group/va_distance_right , ' /data/distance_va_group/va_distance_right ')"/>
      <bind nodeset="/data/distance_va_group/va_distance_left" type="string" required="true()"/>
      <bind nodeset="/data/distance_va_group/va_distance_left_label" type="string" calculate="jr:choice-name( /data/distance_va_group/va_distance_left , ' /data/distance_va_group/va_distance_left ')"/>
      <bind nodeset="/data/external_eye_group/external_eye_note" readonly="true()" type="string"/>
      <bind nodeset="/data/external_eye_group/ext_crust_pus" type="string" required="true()"/>
      <bind nodeset="/data/external_eye_group/ext_crust_pus_label" type="string" calculate="jr:choice-name( /data/external_eye_group/ext_crust_pus , ' /data/external_eye_group/ext_crust_pus ')"/>
      <bind nodeset="/data/external_eye_group/ext_swelling" type="string" required="true()"/>
      <bind nodeset="/data/external_eye_group/ext_swelling_label" type="string" calculate="jr:choice-name( /data/external_eye_group/ext_swelling , ' /data/external_eye_group/ext_swelling ')"/>
      <bind nodeset="/data/external_eye_group/ext_abnormal_eyelashes" type="string" required="true()"/>
      <bind nodeset="/data/external_eye_group/ext_abnormal_eyelashes_label" type="string" calculate="jr:choice-name( /data/external_eye_group/ext_abnormal_eyelashes , ' /data/external_eye_group/ext_abnormal_eyelashes ')"/>
      <bind nodeset="/data/external_eye_group/ext_excessive_watering" type="string" required="true()"/>
      <bind nodeset="/data/external_eye_group/ext_excessive_watering_label" type="string" calculate="jr:choice-name( /data/external_eye_group/ext_excessive_watering , ' /data/external_eye_group/ext_excessive_watering ')"/>
      <bind nodeset="/data/external_eye_group/ext_red_conjunctiva" type="string" required="true()"/>
      <bind nodeset="/data/external_eye_group/ext_red_conjunctiva_label" type="string" calculate="jr:choice-name( /data/external_eye_group/ext_red_conjunctiva , ' /data/external_eye_group/ext_red_conjunctiva ')"/>
      <bind nodeset="/data/external_eye_group/ext_hazy_cornea" type="string" required="true()"/>
      <bind nodeset="/data/external_eye_group/ext_hazy_cornea_label" type="string" calculate="jr:choice-name( /data/external_eye_group/ext_hazy_cornea , ' /data/external_eye_group/ext_hazy_cornea ')"/>
      <bind nodeset="/data/external_eye_group/ext_unequal_alignment" type="string" required="true()"/>
      <bind nodeset="/data/external_eye_group/ext_unequal_alignment_label" type="string" calculate="jr:choice-name( /data/external_eye_group/ext_unequal_alignment , ' /data/external_eye_group/ext_unequal_alignment ')"/>
      <bind nodeset="/data/calc_refer_history" type="string" calculate="if( /data/case_history_group/history_premature  = 'yes' or  /data/case_history_group/history_low_birth_weight  = 'yes' or  /data/case_history_group/history_birth_defects  = 'yes' or  /data/case_history_group/history_parent_concerns  = 'yes' or  /data/case_history_group/history_eye_pain  = 'yes' or  /data/case_history_group/history_diabetes  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_refer_va" type="string" calculate="if( /data/patient_age_in_years  &gt;= 3 and ( /data/distance_va_group/va_distance_right  = 'fail' or  /data/distance_va_group/va_distance_left  = 'fail'), 'true', 'false')"/>
      <bind nodeset="/data/calc_refer_external" type="string" calculate="if( /data/external_eye_group/ext_crust_pus  = 'yes' or  /data/external_eye_group/ext_swelling  = 'yes' or  /data/external_eye_group/ext_abnormal_eyelashes  = 'yes' or  /data/external_eye_group/ext_excessive_watering  = 'yes' or  /data/external_eye_group/ext_red_conjunctiva  = 'yes' or  /data/external_eye_group/ext_hazy_cornea  = 'yes' or  /data/external_eye_group/ext_unequal_alignment  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_vision_referral" type="string" calculate="if( /data/calc_refer_history  = 'true' or  /data/calc_refer_va  = 'true' or  /data/calc_refer_external  = 'true', 'true', 'false')"/>
      <bind nodeset="/data/calc_vision_pass" type="string" calculate="if( /data/calc_vision_referral  = 'false', 'true', 'false')"/>
      <bind nodeset="/data/results_refer_group" relevant=" /data/calc_vision_referral  = 'true'"/>
      <bind nodeset="/data/results_refer_group/res_refer_banner" readonly="true()" type="string" relevant=" /data/calc_vision_referral  = 'true'"/>
      <bind nodeset="/data/results_refer_group/res_refer_history" readonly="true()" type="string" relevant=" /data/calc_refer_history  = 'true'"/>
      <bind nodeset="/data/results_refer_group/res_refer_pain" readonly="true()" type="string" relevant=" /data/case_history_group/history_eye_pain  = 'yes'"/>
      <bind nodeset="/data/results_refer_group/res_refer_va" readonly="true()" type="string" relevant=" /data/calc_refer_va  = 'true'"/>
      <bind nodeset="/data/results_refer_group/res_refer_external" readonly="true()" type="string" relevant=" /data/calc_refer_external  = 'true'"/>
      <bind nodeset="/data/results_refer_group/res_refer_protocol" readonly="true()" type="string" relevant=" /data/calc_vision_referral  = 'true'"/>
      <bind nodeset="/data/results_pass_group" relevant=" /data/calc_vision_pass  = 'true'"/>
      <bind nodeset="/data/results_pass_group/res_pass_banner" readonly="true()" type="string" relevant=" /data/calc_vision_pass  = 'true'"/>
      <bind nodeset="/data/results_pass_group/res_pass_counseling" readonly="true()" type="string" relevant=" /data/calc_vision_pass  = 'true'"/>
      <bind nodeset="/data/data/_screening_result" type="string" calculate="if( /data/calc_vision_referral  = 'true', 'refer', 'pass')"/>
      <bind nodeset="/data/data/_referral_reason_history" type="string" calculate=" /data/calc_refer_history "/>
      <bind nodeset="/data/data/_referral_reason_va" type="string" calculate=" /data/calc_refer_va "/>
      <bind nodeset="/data/data/_referral_reason_external" type="string" calculate=" /data/calc_refer_external "/>
      <bind nodeset="/data/data/_va_distance_right" type="string" calculate=" /data/distance_va_group/va_distance_right "/>
      <bind nodeset="/data/data/_va_distance_left" type="string" calculate=" /data/distance_va_group/va_distance_left "/>
      <bind nodeset="/data/data/_has_parent_concerns" type="string" calculate=" /data/case_history_group/history_parent_concerns "/>
      <bind nodeset="/data/data/_has_birth_defects" type="string" calculate=" /data/case_history_group/history_birth_defects "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
