          <source>user</source>
          <source_id/>
          <patient_uuid tag="hidden"/>
          <patient_id tag="hidden"/>
          <patient_name tag="hidden"/>
          <patient_short_name tag="hidden"/>
          <patient_display_name tag="hidden"/>
          <patient_sex/>
          <patient_date_of_birth>0</patient_date_of_birth>
          <patient_age_in_years tag="hidden">0</patient_age_in_years>
          <patient_age_in_months tag="hidden">0</patient_age_in_months>
          <patient_age_in_days tag="hidden"/>
          <patient_age_in_weeks/>
          <undo>
            <undo_information/>
          </undo>
          <group_review tag="hidden">
            <submit/>
            <r_summary_details/>
            <c_patient_age/>
            <r_patient_details/>
            <r_key_instruction/>
            <blank_note/>
            <r_undo_confirm/>
          </group_review>
          <data tag="hidden">
            <__confirm_undo tag="Whether or not the health worker wants to confirm undoing the death report."/>
            <meta tag="hidden">
              <__patient_uuid/>
              <__patient_id/>
              <__household_uuid/>
              <__source/>
              <__source_id/>
            </meta>
          </data>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
