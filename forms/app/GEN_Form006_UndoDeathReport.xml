      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/user/facility_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" calculate="../inputs/contact/patient_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_display_name" type="string" calculate="if(../patient_short_name = '', ../patient_name, concat(../patient_name, ' (', ../patient_short_name, ')'))"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/undo/undo_information" type="string" required="true()" constraint=". = 'yes'" jr:constraintMsg="jr:itext('/data/undo/undo_information:jr:constraintMsg')"/>
      <bind nodeset="/data/group_review/submit" readonly="true()" type="string"/>
      <bind nodeset="/data/group_review/r_summary_details" readonly="true()" type="string"/>
      <bind nodeset="/data/group_review/c_patient_age" type="string" calculate="if(../../patient_age_in_days &lt; 31, concat(../../patient_age_in_days, ' days old'), if(../../patient_age_in_months &lt; 12, concat(../../patient_age_in_months, ' months old'), concat(../../patient_age_in_years, ' years old')))"/>
      <bind nodeset="/data/group_review/r_patient_details" readonly="true()" type="string"/>
      <bind nodeset="/data/group_review/r_key_instruction" readonly="true()" type="string"/>
      <bind nodeset="/data/group_review/blank_note" readonly="true()" type="string"/>
      <bind nodeset="/data/group_review/r_undo_confirm" readonly="true()" type="string"/>
      <bind nodeset="/data/data/__confirm_undo" type="string" calculate=" /data/undo/undo_information "/>
      <bind nodeset="/data/data/meta/__patient_uuid" type="string" calculate="../../../inputs/contact/_id"/>
      <bind nodeset="/data/data/meta/__patient_id" type="string" calculate="../../../inputs/contact/patient_id"/>
      <bind nodeset="/data/data/meta/__household_uuid" type="string" calculate="../../../inputs/contact/parent/_id"/>
      <bind nodeset="/data/data/meta/__source" type="string" calculate="../../../inputs/source"/>
      <bind nodeset="/data/data/meta/__source_id" type="string" calculate="../../../inputs/source_id"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/undo">
      <select1 ref="/data/undo/undo_information" appearance="multiline">
        <label ref="jr:itext('/data/undo/undo_information:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/group_review">
      <input ref="/data/group_review/submit">
        <label ref="jr:itext('/data/group_review/submit:label')"/>
      </input>
      <input ref="/data/group_review/r_summary_details" appearance="h1 yellow">
        <label ref="jr:itext('/data/group_review/r_summary_details:label')"/>
      </input>
      <input ref="/data/group_review/r_patient_details">
        <label ref="jr:itext('/data/group_review/r_patient_details:label')"/>
      </input>
      <input ref="/data/group_review/r_key_instruction" appearance="h1 blue">
        <label ref="jr:itext('/data/group_review/r_key_instruction:label')"/>
      </input>
      <input ref="/data/group_review/blank_note"/>
      <input ref="/data/group_review/r_undo_confirm" appearance="h1 red">
        <label ref="jr:itext('/data/group_review/r_undo_confirm:label')"/>
      </input>
    </group>
    <group appearance="hidden" ref="/data/data">
      <group ref="/data/data/meta"/>
    </group>
  </h:body>
</h:html>